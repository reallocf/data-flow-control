#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)

if [ -t 0 ] && [ -t 1 ]; then
  docker run --rm -it \
    -v "$REPO_ROOT:/workspace" \
    -w /workspace \
    iitdbgroup/gprom:latest "$@"
else
  docker run --rm -i \
    -v "$REPO_ROOT:/workspace" \
    -w /workspace \
    iitdbgroup/gprom:latest "$@"
fi
