#!/usr/bin/env sh
set -eu

CONTAINER_NAME=${PROVSQL_CONTAINER_NAME:-data-flow-provsql}

if docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  docker stop "$CONTAINER_NAME" >/dev/null
  echo "Stopped ProvSQL container $CONTAINER_NAME"
else
  echo "No ProvSQL container named $CONTAINER_NAME exists"
fi
