SOURCE regz_context
SINK payment_allocations AS allocation
CONSTRAINT
    (regz_context.kind <> 'allocation' OR (regz_context.method = 'default' OR (regz_context.request_basis <> 'contact' OR (regz_context.affirmative AND regz_context.instruction_count > 0 AND regz_context.contact_channel))))
ON FAIL REMOVE
